# Copy this file to .streamlit/secrets.toml for local development
# (secrets.toml is in .gitignore, it will never be committed).
#
# On Streamlit Community Cloud, do NOT upload this file. Instead paste
# the same two lines into: App settings -> Secrets, after deploying.

GEMINI_API_KEY = "your-gemini-api-key-here"
GEMINI_MODEL = "gemini-2.0-flash"
